G_CLIENT_ID=
G_CLIENT_SECRET=
JWT_SECRET=
INIT_TABLE=true
ENABLE_CACHE=true
PRODUCTHUNT_API_TOKEN=

# iFlow API (for L3 AI scoring)
IFLOW_API_KEY=
IFLOW_BASE_URL=https://apis.iflow.cn/v1
IFLOW_MODEL=qwen3-max

# Ollama (for L2 semantic deduplication)
OLLAMA_BASE_URL=http://localhost:11434

# DeepSeek API (for L3 AI scoring and digest generation)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# =====================================================
# Webhook 配置
# =====================================================
# 开发环境 (pnpm dev): 优先使用 TEST_WEBHOOK，如果未配置则使用 WEBHOOK
# 生产环境 (Docker/CF_PAGES): 只使用 WEBHOOK
# =====================================================

# 生产环境 webhook (用于 Docker/CF_PAGES 部署和定时任务)
FEISHU_WEBHOOK=
WECOM_WEBHOOK=

# 测试环境 webhook (仅用于 pnpm dev 开发测试)
FEISHU_TEST_WEBHOOK=
WECOM_TEST_WEBHOOK=

# Digest URL base (for generating digest links)
DIGEST_BASE_URL=http://localhost:4444
